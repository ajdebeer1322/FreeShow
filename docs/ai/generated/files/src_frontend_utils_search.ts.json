ils/search.ts","line":105,"endLine":105,"text":"// Scoring model (absolute confidence, 0-100 — the value shown by the match bar):","start":3668,"end":3749},{"file":"src/frontend/utils/search.ts","line":106,"endLine":106,"text":"//   100    exact song number / CCLI / title, or title starts-with","start":3750,"end":3816},{"file":"src/frontend/utils/search.ts","line":107,"endLine":107,"text":"//   80-94  every word in the title (adjacent words score highest)","start":3817,"end":3883},{"file":"src/frontend/utils/search.ts","line":108,"endLine":108,"text":"//   65-85  strong fuzzy title match (typo tolerance)","start":3884,"end":3937},{"file":"src/frontend/utils/search.ts","line":109,"endLine":109,"text":"//   55-78  words split between title and content","start":3938,"end":3987},{"file":"src/frontend/utils/search.ts","line":110,"endLine":110,"text":"//   35-60  every word in the content (lyrics) only (exponential decay for repeated hits)","start":3988,"end":4077},{"file":"src/frontend/utils/search.ts","line":111,"endLine":111,"text":"// A show only matches when EVERY search word matches at the start of a word in the","start":4078,"end":4161},{"file":"src/frontend/utils/search.ts","line":112,"endLine":112,"text":"// title or content, so adding words always narrows the results (\"here\" never","start":4162,"end":4239},{"file":"src/frontend/utils/search.ts","line":113,"endLine":113,"text":"// matches \"There's\"). A \"quoted\" query requires the exact phrase.","start":4240,"end":4306},{"file":"src/frontend/utils/search.ts","line":122,"endLine":122,"text":"// a \"quoted\" query forces a strict, literal phrase match (no fuzzy / per-word scatter)","start":4706,"end":4793},{"file":"src/frontend/utils/search.ts","line":135,"endLine":135,"text":"// Priority 0: song number exact match (supports alphanumeric like \"MP133\")","start":5194,"end":5269},{"file":"src/frontend/utils/search.ts","line":137,"endLine":137,"text":"// Priority 0.5: CCLI exact match","start":5343,"end":5376},{"file":"src/frontend/utils/search.ts","line":143,"endLine":143,"text":"// Priority 1: title exact match","start":5574,"end":5606},{"file":"src/frontend/utils/search.ts","line":150,"endLine":150,"text":"// strict AND: every word must appear (in title or content) at the start of a word","start":5809,"end":5891},{"file":"src/frontend/utils/search.ts","line":163,"endLine":163,"text":"// typo tolerance (titles only): a strong fuzzy title match can still qualify.","start":6317,"end":6395},{"file":"src/frontend/utils/search.ts","line":172,"endLine":172,"text":"// 1. Full despaced title similarity (e.g. 'amzinggrace' for 'Amazing Grace')","start":6659,"end":6736},{"file":"src/frontend/utils/search.ts","line":179,"endLine":179,"text":"// 2. Word-by-word token similarity (e.g. 'amzing grac' for 'Amazing Grace How Sweet')","start":7069,"end":7155},{"file":"src/frontend/utils/search.ts","line":220,"endLine":220,"text":"// exponential decay function for repeated matches: MaxBonus * (1 - factor^count)","start":8279,"end":8360},{"file":"src/frontend/utils/search.ts","line":226,"endLine":226,"text":"// score a full strict match into the absolute confidence bands (35-94)","start":8522,"end":8593},{"file":"src/frontend/utils/search.ts","line":231,"endLine":231,"text":"// every word in the title: 75-94 (starts-with, exact-word vs prefix, adjacency, coverage)","start":8795,"end":8885},{"file":"src/frontend/utils/search.ts","line":252,"endLine":252,"text":"// words split between title and content: 55-78","start":9801,"end":9848},{"file":"src/frontend/utils/search.ts","line":259,"endLine":259,"text":"// content (lyrics) only: 35-60, rewarding adjacency and repeated phrase/word hits with exponential decay","start":10148,"end":10253},{"file":"src/frontend/utils/search.ts","line":273,"endLine":273,"text":"// does any word in text start with `word`? (indexOf walk — no allocations)","start":10718,"end":10793},{"file":"src/frontend/utils/search.ts","line":283,"endLine":283,"text":"// first index of `phrase` starting at a word boundary, or -1.","start":11039,"end":11101},{"file":"src/frontend/utils/search.ts","line":284,"endLine":284,"text":"// exactEnd requires the phrase to also END at a word boundary (quoted queries);","start":11102,"end":11182},{"file":"src/frontend/utils/search.ts","line":285,"endLine":285,"text":"// otherwise the last word may continue (\"amazing gra\" finds \"amazing grace\")","start":11183,"end":11260},{"file":"src/frontend/utils/search.ts","line":296,"endLine":296,"text":"// count word-boundary occurrences of `phrase` (the last word may continue)","start":11637,"end":11712},{"file":"src/frontend/utils/search.ts","line":308,"endLine":308,"text":"// fraction (0-1) of consecutive query-word pairs appearing as consecutive title words in order (prefix-matched)","start":12030,"end":12142},{"file":"src/frontend/utils/search.ts","line":322,"endLine":322,"text":"// fraction (0-1) of consecutive query-word pairs found adjacent in the content text","start":12616,"end":12700}],"$parts":{"symbols":["files/parts/src_frontend_utils_search.ts-0-symbols-1.json","files/parts/src_frontend_utils_search.ts-0-symbols-2.json","files/parts/src_frontend_utils_search.ts-0-symbols-3.json"]}}
