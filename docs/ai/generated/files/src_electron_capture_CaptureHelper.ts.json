":"VariableDeclaration","endLine":102},{"file":"src/electron/capture/CaptureHelper.ts","line":105,"name":"fps","kind":"VariableDeclaration","endLine":105},{"file":"src/electron/capture/CaptureHelper.ts","line":112,"name":"idle","kind":"VariableDeclaration","endLine":112},{"file":"src/electron/capture/CaptureHelper.ts","line":113,"name":"target","kind":"VariableDeclaration","endLine":113},{"file":"src/electron/capture/CaptureHelper.ts","line":123,"name":"getWindowScreen","kind":"MethodDeclaration","endLine":130},{"file":"src/electron/capture/CaptureHelper.ts","line":132,"name":"captureBase64Frame","kind":"MethodDeclaration","endLine":134},{"file":"src/electron/capture/CaptureHelper.ts","line":136,"name":"resizeImage","kind":"MethodDeclaration","endLine":141}],"stores":[],"components":[],"timers":[],"workarounds":[],"settings":[],"ipc":[],"comments":[{"file":"src/electron/capture/CaptureHelper.ts","line":15,"endLine":15,"text":"// StageShow","start":628,"end":640},{"file":"src/electron/capture/CaptureHelper.ts","line":16,"endLine":16,"text":"// 30 // OutputShow","start":661,"end":680},{"file":"src/electron/capture/CaptureHelper.ts","line":17,"endLine":17,"text":"// WebRTC (canvas stream, up to 30 fps)","start":701,"end":740},{"file":"src/electron/capture/CaptureHelper.ts","line":18,"endLine":18,"text":"// RTMP","start":759,"end":766},{"file":"src/electron/capture/CaptureHelper.ts","line":19,"endLine":19,"text":"// Output recording","start":789,"end":808},{"file":"src/electron/capture/CaptureHelper.ts","line":21,"endLine":21,"text":"// NDI","start":855,"end":861},{"file":"src/electron/capture/CaptureHelper.ts","line":49,"endLine":49,"text":"// START","start":1853,"end":1861},{"file":"src/electron/capture/CaptureHelper.ts","line":93,"endLine":93,"text":"// GPU budget: rendering several 4K OSR surfaces at 60fps saturates the GPU and balloons every","start":4044,"end":4138},{"file":"src/electron/capture/CaptureHelper.ts","line":94,"endLine":94,"text":"// readback (~20ms -> ~100ms) -> the received output only gets a few NEW frames/sec. So render each OSR","start":4147,"end":4250},{"file":"src/electron/capture/CaptureHelper.ts","line":95,"endLine":95,"text":"// output at the rate it actually needs: full rate when a receiver is connected, a low rate when not.","start":4259,"end":4360},{"file":"src/electron/capture/CaptureHelper.ts","line":96,"endLine":96,"text":"// Reacts within CONNECTION_POLL_INTERVAL_MS (250ms), so a connecting output ramps to 60 quickly.","start":4369,"end":4466},{"file":"src/electron/capture/CaptureHelper.ts","line":107,"endLine":107,"text":"// setFrameRate is NOT a decimator: driving the OSR compositor below its native cadence makes","start":4919,"end":5012},{"file":"src/electron/capture/CaptureHelper.ts","line":108,"endLine":108,"text":"// Chromium deliver paints in clumps, starving the capture pipe and stuttering preview and","start":5021,"end":5111},{"file":"src/electron/capture/CaptureHelper.ts","line":109,"endLine":109,"text":"// output alike. Connected renderers render at the native rate; each consumer's configured","start":5120,"end":5210},{"file":"src/electron/capture/CaptureHelper.ts","line":110,"endLine":110,"text":"// framerate is enforced by admission-time decimation + the worker's send pacer. The sub-native","start":5219,"end":5314},{"file":"src/electron/capture/CaptureHelper.ts","line":111,"endLine":111,"text":"// setting survives only as the idle floor (no connected receiver — nobody sees the frames).","start":5323,"end":5415},{"file":"src/electron/capture/CaptureHelper.ts","line":119,"endLine":119,"text":"// Linux begin-frame drive (no-op elsewhere): keep its cadence in lockstep with the applied rate","start":5697,"end":5793}]}
