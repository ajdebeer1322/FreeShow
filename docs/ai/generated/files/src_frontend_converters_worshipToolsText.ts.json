  {"file":"src/frontend/converters/worshipToolsText.ts","area":"frontend","hash":"2058cf6b55ef529a3730471cc423c762db5f3bf0012941f2e5973714da2f6eb1","lineCount":318,"imports":[{"file":"src/frontend/converters/worshipToolsText.ts","line":18,"specifier":"../../types/WorshipTools","target":"src/types/WorshipTools.ts","kind":"static","typeOnly":true,"bindings":[{"local":"WorshipToolsChart","imported":"WorshipToolsChart","typeOnly":true}]}],"stores":[],"components":[],"timers":[],"workarounds":[],"settings":[],"ipc":[],"comments":[{"file":"src/frontend/converters/worshipToolsText.ts","line":1,"endLine":1,"text":"// Turns the lyrics read from WorshipTools into the text format of \"Quick lyrics\" (see txt.ts convertText).","start":0,"end":107},{"file":"src/frontend/converters/worshipToolsText.ts","line":2,"endLine":2,"text":"// Pure helpers without any store access.","start":108,"end":149},{"file":"src/frontend/converters/worshipToolsText.ts","line":3,"endLine":3,"text":"//","start":150,"end":152},{"file":"src/frontend/converters/worshipToolsText.ts","line":4,"endLine":4,"text":"//   [Verse 1]","start":153,"end":167},{"file":"src/frontend/converters/worshipToolsText.ts","line":5,"endLine":5,"text":"//   line","start":168,"end":177},{"file":"src/frontend/converters/worshipToolsText.ts","line":6,"endLine":6,"text":"//   line","start":178,"end":187},{"file":"src/frontend/converters/worshipToolsText.ts","line":7,"endLine":7,"text":"//","start":188,"end":190},{"file":"src/frontend/converters/worshipToolsText.ts","line":8,"endLine":8,"text":"//   [Chorus]","start":191,"end":204},{"file":"src/frontend/converters/worshipToolsText.ts","line":9,"endLine":9,"text":"//   line","start":205,"end":214},{"file":"src/frontend/converters/worshipToolsText.ts","line":10,"endLine":10,"text":"//   x2            <- the section is repeated","start":215,"end":260},{"file":"src/frontend/converters/worshipToolsText.ts","line":11,"endLine":11,"text":"//","start":261,"end":263},{"file":"src/frontend/converters/worshipToolsText.ts","line":12,"endLine":12,"text":"// Directions in the chart are interpreted:","start":264,"end":307},{"file":"src/frontend/converters/worshipToolsText.ts","line":13,"endLine":13,"text":"// - \"x2\", \"2x\", \"(repeat 2x)\" repeat the section they are in","start":308,"end":369},{"file":"src/frontend/converters/worshipToolsText.ts","line":14,"endLine":14,"text":"// - \"Repeat chorus\" adds that section again after the current one","start":370,"end":436},{"file":"src/frontend/converters/worshipToolsText.ts","line":15,"endLine":15,"text":"// - \"Instrumental\", \"Interlude\", \"Solo\" ... are removed","start":437,"end":493},{"file":"src/frontend/converters/worshipToolsText.ts","line":16,"endLine":16,"text":"// - anything else is kept out of the slides and returned as notes","start":494,"end":560},{"file":"src/frontend/converters/worshipToolsText.ts","line":23,"endLine":23,"text":"// lines longer than this many characters are broken in two (0 = never)","start":684,"end":755},{"file":"src/frontend/converters/worshipToolsText.ts","line":31,"endLine":31,"text":"// text for convertText","start":883,"end":906},{"file":"src/frontend/converters/worshipToolsText.ts","line":41,"endLine":41,"text":"// sections that are only chords (no words), they are not shown","start":1352,"end":1415},{"file":"src/frontend/converters/worshipToolsText.ts","line":43,"endLine":43,"text":"// jump instructions of the chart (\"To Bridge 1b\", \"Last x\", \"D.S.\") are not lyrics and not worth a note","start":1544,"end":1648},{"file":"src/frontend/converters/worshipToolsText.ts","line":72,"endLine":72,"text":"// first / second ending \"(1.)\"","start":2771,"end":2802},{"file":"src/frontend/converters/worshipToolsText.ts","line":78,"endLine":78,"text":"// \"x2\", \"2x\", \"repeat 2x\", \"(x2)\"","start":2954,"end":2988},{"file":"src/frontend/converters/worshipToolsText.ts","line":86,"endLine":86,"text":"// \"Repeat chorus\", \"Chorus again\", \"Back to chorus\", \"Chorus x2\"","start":3276,"end":3341},{"file":"src/frontend/converters/worshipToolsText.ts","line":95,"endLine":95,"text":"// text fixes for the slides: straight quotes (the curly apostrophe leaves a gap in many fonts),","start":3804,"end":3900},{"file":"src/frontend/converters/worshipToolsText.ts","line":96,"endLine":96,"text":"// and the \" - \" the charts print between the parts of a word that has a chord in the middle (\"a - gain\")","start":3901,"end":4006},{"file":"src/frontend/converters/worshipToolsText.ts","line":107,"endLine":107,"text":"// breaks a long line at the best place near the middle, a comma or similar is preferred","start":4338,"end":4426},{"file":"src/frontend/converters/worshipToolsText.ts","line":139,"endLine":139,"text":"// a copy of the latest section that the instruction points to (\"chorus\" finds \"Chorus\" or \"Chorus 2\")","start":5467,"end":5569},{"file":"src/frontend/converters/worshipToolsText.ts","line":149,"endLine":149,"text":"// instruction looking lines inside the lyrics are only treated as directions when they are clearly one","start":5916,"end":6019},{"file":"src/frontend/converters/worshipToolsText.ts","line":160,"endLine":160,"text":"// \"CHORUS 1A\" -> \"Chorus 1\": the variant letter keeps Free Show from finding the group (and its colour)","start":6416,"end":6520},{"file":"src/frontend/converters/worshipToolsText.ts","line":168,"endLine":168,"text":"// \"Chorus (2x)\" and \"Chorus x2\"","start":6785,"end":6817},{"file":"src/frontend/converters/worshipToolsText.ts","line":172,"endLine":172,"text":"// \"Verse 1 Repeat\" points to a section that was already sung","start":6959,"end":7020},{"file":"src/frontend/converters/worshipToolsText.ts","line":192,"endLine":192,"text":"// a trailing jump cue on a lyric line: \"words (To Turnaround)\", \"words (Last x)\"","start":7576,"end":7657},{"file":"src/frontend/converters/worshipToolsText.ts","line":206,"endLine":206,"text":"// first / second endings repeat the same words, only the first one is kept","start":8288,"end":8363},{"file":"src/frontend/converters/worshipToolsText.ts","line":225,"endLine":225,"text":"// \"(2.) Words\" starts an ending on the same line, a lone \"(2.)\" is handled as a direction below","start":9009,"end":9105},{"file":"src/frontend/converters/worshipToolsText.ts","line":251,"endLine":251,"text":"// \"Verse 1 Repeat\": the section itself is the repeat","start":10187,"end":10240},{"file":"src/frontend/converters/worshipToolsText.ts","line":253,"endLine":253,"text":"// sections with only chords (intro, interlude, turnaround...) are not shown","start":10317,"end":10393},{"file":"src/frontend/converters/worshipToolsText.ts","line":279,"endLine":279,"text":"// pipes separate the names in the chart","start":11369,"end":11409},{"file":"src/frontend/converters/worshipToolsText.ts","line":292,"endLine":292,"text":"// drop empty values","start":11966,"end":11986}],"$parts":{"symbols":["files/parts/src_frontend_converters_worshipToolsText.ts-0-symbols-1.json","files/parts/src_frontend_converters_worshipToolsText.ts-0-symbols-2.json"]}}
]
