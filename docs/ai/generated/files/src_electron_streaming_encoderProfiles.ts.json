 format the encoder wants, applied through the filter chain */","start":481,"end":552},{"file":"src/electron/streaming/encoderProfiles.ts","line":18,"endLine":18,"text":"/** args that must appear before the first -i */","start":581,"end":629},{"file":"src/electron/streaming/encoderProfiles.ts","line":20,"endLine":20,"text":"/** filter appended after the format conversion */","start":658,"end":708},{"file":"src/electron/streaming/encoderProfiles.ts","line":22,"endLine":22,"text":"/** encoder specific args, placed after -c:v <codec> */","start":739,"end":794},{"file":"src/electron/streaming/encoderProfiles.ts","line":45,"endLine":45,"text":"// prio_speed minimizes latency; avoid -realtime 1 to prevent internal frame drops from pipe jitter","start":1603,"end":1702},{"file":"src/electron/streaming/encoderProfiles.ts","line":46,"endLine":46,"text":"// use the shared rateControl helper so -bufsize is set consistently for better CBR behavior","start":1711,"end":1803},{"file":"src/electron/streaming/encoderProfiles.ts","line":47,"endLine":47,"text":"// -bf 0 prevents B-frame buffering latency and DTS/PTS disorder on RTMP streams","start":1812,"end":1892},{"file":"src/electron/streaming/encoderProfiles.ts","line":57,"endLine":57,"text":"// -no-scenecut only applies with rc_lookahead > 0 and -forced-idr only with -force_key_frames,","start":2242,"end":2337},{"file":"src/electron/streaming/encoderProfiles.ts","line":58,"endLine":58,"text":"// neither of which are set here, so both would be silent no-ops","start":2346,"end":2410},{"file":"src/electron/streaming/encoderProfiles.ts","line":102,"endLine":102,"text":"/** Parse the codec ids out of `ffmpeg -hide_banner -encoders` output. */","start":4060,"end":4133},{"file":"src/electron/streaming/encoderProfiles.ts","line":120,"endLine":120,"text":"/** dimensions of the raw frames arriving on stdin */","start":4817,"end":4870},{"file":"src/electron/streaming/encoderProfiles.ts","line":123,"endLine":123,"text":"/** dimensions to broadcast at; a scale filter is added only when it differs from the input */","start":4922,"end":5016},{"file":"src/electron/streaming/encoderProfiles.ts","line":127,"endLine":127,"text":"/** video bitrate in kbps */","start":5086,"end":5114},{"file":"src/electron/streaming/encoderProfiles.ts","line":133,"endLine":133,"text":"/** Full arg list for the encoder process: raw BGRA + PCM in, flv out on stdout. */","start":5187,"end":5270},{"file":"src/electron/streaming/encoderProfiles.ts","line":134,"endLine":134,"text":"// Inside buildEncoderCommand in encoderProfiles.ts:","start":5271,"end":5323},{"file":"src/electron/streaming/encoderProfiles.ts","line":145,"endLine":145,"text":"// VIDEO INPUT PIPE","start":5783,"end":5802},{"file":"src/electron/streaming/encoderProfiles.ts","line":150,"endLine":150,"text":"// AUDIO INPUT PIPE","start":6139,"end":6158},{"file":"src/electron/streaming/encoderProfiles.ts","line":158,"endLine":158,"text":"// prefer passthrough fps mode and generate PTS to avoid ffmpeg inserting extra buffering","start":6615,"end":6704},{"file":"src/electron/streaming/encoderProfiles.ts","line":168,"endLine":168,"text":"// SWITCH FROM MPEGTS TO FLV FOR RTMP","start":7066,"end":7103},{"file":"src/electron/streaming/encoderProfiles.ts","line":169,"endLine":169,"text":"// FLV is the native format for RTMP relays and YouTube ingest.","start":7108,"end":7171},{"file":"src/electron/streaming/encoderProfiles.ts","line":170,"endLine":170,"text":"// Setting flvflags no_sequence_end prevents stream termination artifacts.","start":7176,"end":7250},{"file":"src/electron/streaming/encoderProfiles.ts","line":176,"endLine":176,"text":"/** Relay process: forward the encoded FLV stream straight to one RTMP/RTMPS destination without re-encoding. */","start":7440,"end":7552},{"file":"src/electron/streaming/encoderProfiles.ts","line":181,"endLine":181,"text":"/** Short throwaway encode used to prove the encoder actually works on this machine. */","start":7760,"end":7847}]}
