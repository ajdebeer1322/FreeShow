server/common/util/transpose.ts","line":83,"endLine":83,"text":"// Check if text contains chord notation in brackets","start":3484,"end":3536},{"file":"src/server/common/util/transpose.ts","line":84,"endLine":84,"text":"// This regex is more specific to avoid matching section labels like [Chorus], [Verse], etc.","start":3541,"end":3633},{"file":"src/server/common/util/transpose.ts","line":89,"endLine":89,"text":"// Check if any match looks like a chord (not a section label)","start":3822,"end":3884},{"file":"src/server/common/util/transpose.ts","line":91,"endLine":91,"text":"// Remove brackets","start":3965,"end":3983},{"file":"src/server/common/util/transpose.ts","line":92,"endLine":92,"text":"// Section labels typically have more than 3 characters and contain lowercase letters","start":3992,"end":4077},{"file":"src/server/common/util/transpose.ts","line":93,"endLine":93,"text":"// that aren't part of chord notation","start":4086,"end":4123}]}
