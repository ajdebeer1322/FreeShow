"line":49,"endLine":49,"text":"// 1. Normalize \"hundred\" numbers (e.g., \"deux cent seize\" -> \"216\", \"one hundred and nineteen\" -> \"119\")","start":2697,"end":2802},{"file":"src/frontend/ai/scripture/numbers.ts","line":62,"endLine":62,"text":"// If baseHundredVal already includes multiplier (e.g. doscientos = 200), don't multiply again","start":3323,"end":3417},{"file":"src/frontend/ai/scripture/numbers.ts","line":67,"endLine":67,"text":"// 2. Normalize special complex numbers (e.g. French \"soixante-seize\" -> 76, \"quatre-vingt-dix-neuf\" -> 99)","start":3569,"end":3676},{"file":"src/frontend/ai/scripture/numbers.ts","line":73,"endLine":73,"text":"// 3. Normalize German / Dutch / Norwegian reverse compounds (e.g. \"einundzwanzig\" -> \"21\", \"eenentwintig\" -> \"21\", \"enogtjue\" -> \"21\")","start":3884,"end":4019},{"file":"src/frontend/ai/scripture/numbers.ts","line":80,"endLine":80,"text":"// 4. Normalize standard compound tens + units (e.g., \"twenty five\" -> \"25\", \"vingt-trois\" -> \"23\", \"treinta y cinco\" -> \"35\")","start":4279,"end":4405},{"file":"src/frontend/ai/scripture/numbers.ts","line":87,"endLine":87,"text":"// 5. Convert single-word cardinal and ordinal numbers (\"trois\" -> \"3\", \"seize\" -> \"16\", \"eighth\" -> \"8\")","start":4704,"end":4809},{"file":"src/frontend/ai/scripture/numbers.ts","line":93,"endLine":93,"text":"// 6. Normalize range keyword patterns (e.g., \"1 through 6\" -> \"1-6\", \"1 à 6\" -> \"1-6\", \"1 bis 6\" -> \"1-6\")","start":5008,"end":5115}]}
