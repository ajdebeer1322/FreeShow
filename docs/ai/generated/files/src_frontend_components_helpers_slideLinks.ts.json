stores":[],"components":[],"timers":[],"workarounds":[],"settings":[],"ipc":[],"comments":[{"file":"src/frontend/components/helpers/slideLinks.ts","line":1,"endLine":1,"text":"// Linked slides: a slide with \"linkNext\" is shown together with the slide after it as one card, and clicking either one activates both.","start":0,"end":136},{"file":"src/frontend/components/helpers/slideLinks.ts","line":2,"endLine":2,"text":"// The two slides stay separate in the layout (each keeps its own background and specific outputs).","start":137,"end":236},{"file":"src/frontend/components/helpers/slideLinks.ts","line":6,"endLine":9,"text":"/**\n * Groups slide indexes to render: pairs for linked slides, single indexes for the rest.\n * `canLink` can reject a pair (e.g. the outputs changed after linking), which then stays as two single slides.\n */","start":302,"end":510},{"file":"src/frontend/components/helpers/slideLinks.ts","line":23,"endLine":23,"text":"/** Get the other slide index in a linked pair (null if the slide is not linked) */","start":1004,"end":1087},{"file":"src/frontend/components/helpers/slideLinks.ts","line":30,"endLine":34,"text":"/**\n * Slides can only be linked when each one goes to its own output(s). Both need specific outputs (no outputs means every output),\n * and they can't share one, otherwise the two slides would fight over the same screen when activated together.\n * Takes the resolved output ids of each slide.\n */","start":1369,"end":1666},{"file":"src/frontend/components/helpers/slideLinks.ts","line":40,"endLine":40,"text":"/** All slide indexes of the card that contains the index (just the index itself for a single slide) */","start":1859,"end":1962},{"file":"src/frontend/components/helpers/slideLinks.ts","line":45,"endLine":48,"text":"/**\n * A linked card is one slide, so it has one next slide timer: the first slide in the card with a timer sets it for every slide.\n * Without a card the slide keeps its own timer.\n */","start":2205,"end":2390},{"file":"src/frontend/components/helpers/slideLinks.ts","line":57,"endLine":57,"text":"/** Index of the first slide in a linked pair that contains the index (or the index itself) */","start":2665,"end":2759},{"file":"src/frontend/components/helpers/slideLinks.ts","line":62,"endLine":62,"text":"/** Find the slide element (or the linked card holding it) inside a \".grid\" */","start":2937,"end":3015}]}
