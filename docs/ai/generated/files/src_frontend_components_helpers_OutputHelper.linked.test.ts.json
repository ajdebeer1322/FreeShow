nd/components/helpers/OutputHelper.linked.test.ts","line":120,"endLine":120,"text":"// presses are further apart than the 50ms active item cache","start":6204,"end":6264},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":123,"endLine":123,"text":"// delayed \"clear what is left behind\" checks of one test must not run during the next","start":6268,"end":6354},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":154,"endLine":154,"text":"// 0 unbound, 1(A)+2(B) card, 3 unbound, 4(A)+5(B) card, 6 unbound","start":7777,"end":7843},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":171,"endLine":171,"text":"// show goes to A, slide 1 goes to B and is linked with slide 0","start":8544,"end":8607},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":180,"endLine":180,"text":"// B only had its half of the card, so it is cleared when A leaves (pressing space on a cleared output starts it again, as for any cleared screen)","start":8996,"end":9142},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":186,"endLine":186,"text":"// the output style shows 2 lines at a time: slide 0 has 4 lines (2 steps), slide 1 has 1 line","start":9364,"end":9458},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":196,"endLine":196,"text":"// A reveals its second pair of lines while B stays, then both move to the next card together","start":9856,"end":9949},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":211,"endLine":211,"text":"// OutputHelper caches the active item for 50ms","start":10842,"end":10889},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":224,"endLine":224,"text":"// the operator clicked slide 1: only the Side screen shows it","start":11820,"end":11882},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":242,"endLine":242,"text":"// 1: the whole card, 2: next show plays directly (no select-only press), the Centre half is gone, 3 & 4: normal steps","start":12549,"end":12667},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":253,"endLine":253,"text":"// the 3 second timer of the Side screen ends (the Centre timer is cleared with it)","start":13232,"end":13315},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":258,"endLine":258,"text":"// nothing else moves afterwards","start":13497,"end":13529},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":284,"endLine":284,"text":"// the operator clicked the slide before the card: both screens show slide 2","start":15039,"end":15115},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":305,"endLine":305,"text":"// the project view is asked not to scroll to the next show, since it plays right away","start":16155,"end":16241},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":331,"endLine":331,"text":"// every state the outputs go through, to see what is on screen between the updates","start":17999,"end":18082},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":332,"endLine":332,"text":"// (the output windows are updated once per tick with the settled state, see the debounce in utils/listeners.ts)","start":18091,"end":18203},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":352,"endLine":352,"text":"// the Centre background is never cleared on the way","start":18802,"end":18854},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":356,"endLine":356,"text":"// the linked card","start":19011,"end":19029},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":358,"endLine":358,"text":"// straight over the empty Preservice and the empty section into Preek 3 (Side only), the Centre half is gone","start":19110,"end":19219},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":363,"endLine":363,"text":"// end of Preek 3: Redeem starts on BOTH screens (Centre does not stay behind)","start":19500,"end":19578},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":368,"endLine":368,"text":"// the Centre half of the card is never sent to the output windows together with the first Preek 3 slide","start":19746,"end":19850},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":408,"endLine":408,"text":"// end of the project: nothing to go to","start":22113,"end":22152},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":441,"endLine":441,"text":"// 0 for both, 1 only Centre, 2 and 3 only Side","start":23733,"end":23780},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":449,"endLine":449,"text":"// Centre has no more slides, but Side still has: the project stays on this show","start":24256,"end":24336},{"file":"src/frontend/components/helpers/OutputHelper.linked.test.ts","line":453,"endLine":453,"text":"// everybody is at the end: both move on to the next show","start":24502,"end":24559}],"$parts":{"symbols":["files/parts/src_frontend_components_helpers_OutputHelper.linked.test.ts-0-symbols-1.json","files/parts/src_frontend_components_helpers_OutputHelper.linked.test.ts-0-symbols-2.json"],"stores":["files/parts/src_frontend_components_helpers_OutputHelper.linked.test.ts-0-stores-1.json","files/parts/src_frontend_components_helpers_OutputHelper.linked.test.ts-0-stores-2.json","files/parts/src_frontend_components_helpers_OutputHelper.linked.test.ts-0-stores-3.json"]}}
