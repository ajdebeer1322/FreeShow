/server/common/util/dBUtils.ts","line":86,"name":"prefix","kind":"VariableDeclaration","endLine":86}],"stores":[],"components":[],"timers":[],"workarounds":[],"settings":[],"ipc":[],"comments":[{"file":"src/server/common/util/dBUtils.ts","line":1,"endLine":3,"text":"/**\n * Utility functions for audio gain and dB (decibel) conversions.\n */","start":0,"end":73},{"file":"src/server/common/util/dBUtils.ts","line":8,"endLine":11,"text":"/**\n * Convert linear gain (0.0 to N) to decibels (dB).\n * 0 gain maps to -Infinity dB (or MIN_DB threshold).\n */","start":126,"end":239},{"file":"src/server/common/util/dBUtils.ts","line":17,"endLine":20,"text":"/**\n * Convert decibels (dB) to linear gain (0.0 to N).\n * -Infinity dB (or <= -60 dB when clamped) maps to 0 gain.\n */","start":367,"end":486},{"file":"src/server/common/util/dBUtils.ts","line":26,"endLine":32,"text":"/**\n * Maps linear gain to a normalized slider position (0.0 to 1.0)\n * using a piecewise fader curve:\n * - Slider 0.0 -> -60 dB (0 gain)\n * - Slider 0.8 -> 0 dB (1.0 gain, unit unity)\n * - Slider 1.0 -> +6 dB (~2.0 gain)\n */","start":621,"end":846},{"file":"src/server/common/util/dBUtils.ts","line":43,"endLine":45,"text":"/**\n * Maps normalized slider position (0.0 to 1.0) to linear gain.\n */","start":1125,"end":1196},{"file":"src/server/common/util/dBUtils.ts","line":57,"endLine":59,"text":"/**\n * Maps a decibel value (e.g. -60 dB to 0 dB) to a normalized 0.0 to 1.0 position ratio.\n */","start":1479,"end":1575},{"file":"src/server/common/util/dBUtils.ts","line":66,"endLine":68,"text":"/**\n * Calculates peak amplitude dBFS from time domain Float32Array PCM audio buffer.\n */","start":1773,"end":1862},{"file":"src/server/common/util/dBUtils.ts","line":79,"endLine":81,"text":"/**\n * Formats a linear gain value as a user-friendly dB string (e.g., \"-∞ dB\", \"0.0 dB\", \"+3.2 dB\").\n */","start":2201,"end":2306}]}
