":[],"timers":[],"workarounds":[],"settings":[],"ipc":[],"comments":[{"file":"src/frontend/components/helpers/slideTransfer.ts","line":13,"endLine":13,"text":"// Copying slides between shows and arrangements (copy/paste and dragging between shows in the continuous Show view).","start":554,"end":671},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":14,"endLine":14,"text":"// A slide selection entry is `{ index, showId, layout? }`: the index is the flattened position in that arrangement.","start":672,"end":788},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":15,"endLine":15,"text":"// Always read and write through the entry's own show/arrangement, because the opened show is not necessarily the one clicked.","start":789,"end":915},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":19,"endLine":19,"text":"/** Split a slide selection by the show (and arrangement) its entries belong to. Entries without a show use the opened show. */","start":989,"end":1116},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":38,"endLine":38,"text":"/** The flattened slide list (parents and children) of a show's arrangement. */","start":1647,"end":1726},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":45,"endLine":45,"text":"/** Show lock and profile check for writing slides. Informs the operator when blocked. */","start":1955,"end":2044},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":66,"endLine":66,"text":"/** Clipboard data (slides, their layout settings and used media) for a slide selection. */","start":2566,"end":2657},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":68,"endLine":68,"text":"// dont know why this is like this when ctrl + c","start":2721,"end":2769},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":75,"endLine":75,"text":"// pasting back into the show it was copied from repeats the groups, so remember where they came from","start":3059,"end":3160},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":103,"endLine":103,"text":"// get layout","start":4075,"end":4088},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":111,"endLine":111,"text":"// select all children of group","start":4301,"end":4332},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":125,"endLine":125,"text":"// make children parent","start":4753,"end":4776},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":126,"endLine":126,"text":"// this should never be here","start":4785,"end":4813},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":130,"endLine":130,"text":"// check that parent is not copied","start":4925,"end":4959},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":133,"endLine":133,"text":"// slide.group = \"\"","start":5016,"end":5035},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":158,"endLine":158,"text":"/** Insert position in the flattened slide list. Undefined adds the slides last. */","start":5719,"end":5802},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":162,"endLine":162,"text":"/** Add copies of clipboard slides (see `copySlides`) to a show. Returns false if nothing was added. */","start":5825,"end":5928},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":169,"endLine":169,"text":"// the same groups again in the arrangement (not separate copies), unless it is a duplicate","start":6194,"end":6285},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":221,"endLine":221,"text":"// the next paste continues after these slides","start":8129,"end":8175},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":227,"endLine":230,"text":"/**\n * Paste back into the show the slides were copied from: the groups are added to the arrangement again, using the same slides.\n * Returns the flattened index of the last added slide, or null when the slides must be real copies (another show, a child without its group, deleted slides).\n */","start":8312,"end":8605},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":244,"endLine":244,"text":"// every copied child belongs to a copied group, and a copied group has all its children","start":9192,"end":9280},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":250,"endLine":250,"text":"// the slides must still exist (a cut group is gone) and be in the arrangement it was copied from","start":9585,"end":9682},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":260,"endLine":260,"text":"// insert after the whole group at the position (never between a group and its children)","start":9984,"end":10072},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":311,"endLine":314,"text":"/**\n * Where pasted slides go: after an explicit slide (duplicate), otherwise after the selected slides\n * (in the show they belong to, which can differ from the opened show), otherwise last in the opened show.\n */","start":12102,"end":12316},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":322,"endLine":322,"text":"// the last selected slide decides, e.g. a slide of another show added to the selection","start":12733,"end":12820},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":332,"endLine":332,"text":"// a plain click does not select, so paste after the slide that was clicked last (never at the end of a show, which inherits its last background)","start":13207,"end":13352},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":339,"endLine":339,"text":"/** Slide selection for the slide clicked last in the opened show. A plain click does not select, but Ctrl+C should still copy it. */","start":13510,"end":13643},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":355,"endLine":355,"text":"/** The slide the operator clicked last, used as the paste position when no slide is selected. */","start":14250,"end":14347},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":360,"endLine":360,"text":"/** Dragging slides onto a different show (or a different arrangement of the same show) moves them there. */","start":14481,"end":14589},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":369,"endLine":369,"text":"// the same show can be in the project twice with different arrangements","start":14906,"end":14978},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":375,"endLine":378,"text":"/**\n * A song has lyric text in its slides. Its slides are groups that the arrangements point to, so moving one away would break the\n * arrangement. Shows with only images, media or other non-text slides can be moved.\n */","start":15214,"end":15435},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":386,"endLine":386,"text":"/** What removing a selection from its show takes. Null if a slide group is locked (a locked group can't be moved away). */","start":15851,"end":15974},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":403,"endLine":403,"text":"// a slide that is also in another arrangement only leaves this one, otherwise it is removed from the show","start":16713,"end":16819},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":415,"endLine":418,"text":"/**\n * Dragging slides onto a show. Slides of non-song shows move there (added to the destination, then removed from where they came from);\n * `copy` leaves the originals, and slides from a song are always copied so the song's arrangements stay intact. Two history steps: undo first restores the originals, then removes the added slides.\n */","start":17564,"end":17905},{"file":"src/frontend/components/helpers/slideTransfer.ts","line":438,"endLine":438,"text":"// read everything before the destination changes (it can be another arrangement of the same show)","start":18592,"end":18690}],"$parts":{"symbols":["files/parts/src_frontend_components_helpers_slideTransfer.ts-0-symbols-1.json","files/parts/src_frontend_components_helpers_slideTransfer.ts-0-symbols-2.json","files/parts/src_frontend_components_helpers_slideTransfer.ts-0-symbols-3.json"]}}
