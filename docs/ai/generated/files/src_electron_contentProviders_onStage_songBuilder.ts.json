ey -> parent slide id","start":762,"end":795},{"file":"src/electron/contentProviders/onStage/songBuilder.ts","line":35,"endLine":35,"text":"// section numbers that landed on each group, to drop the number from a merged group's name","start":847,"end":938},{"file":"src/electron/contentProviders/onStage/songBuilder.ts","line":37,"endLine":37,"text":"// the ordered slide ids of an arrangement -> its layout id, so services that play the song","start":992,"end":1083},{"file":"src/electron/contentProviders/onStage/songBuilder.ts","line":38,"endLine":38,"text":"// the same way share one arrangement instead of adding a duplicate","start":1088,"end":1155},{"file":"src/electron/contentProviders/onStage/songBuilder.ts","line":67,"endLine":71,"text":"/**\n * Add one service's arrangement of a song to the show, reusing the slides (and the arrangement\n * itself) whenever the same structure was already built. Returns the layout id the service item\n * should point at.\n */","start":1935,"end":2155},{"file":"src/electron/contentProviders/onStage/songBuilder.ts","line":80,"endLine":80,"text":"// Same label + identical lyrics is one group: OnStage numbers every occurrence, so a song","start":2541,"end":2631},{"file":"src/electron/contentProviders/onStage/songBuilder.ts","line":81,"endLine":81,"text":"// repeating its chorus verbatim would otherwise import as Chorus 1, Chorus 2, Chorus 3.","start":2640,"end":2728},{"file":"src/electron/contentProviders/onStage/songBuilder.ts","line":82,"endLine":82,"text":"// An empty (instrumental) section has no lyrics to compare, so it stays keyed by number.","start":2737,"end":2826}]}
