subphrases (sliding window)","start":7900,"end":7941},{"file":"src/frontend/utils/searchFast.ts","line":246,"endLine":246,"text":"// Weight decreases as subphrase gets shorter","start":8156,"end":8201},{"file":"src/frontend/utils/searchFast.ts","line":252,"endLine":252,"text":"// Individual words (filter out very short ones)","start":8347,"end":8395},{"file":"src/frontend/utils/searchFast.ts","line":262,"endLine":262,"text":"// invalidate search index when text cache changes","start":8578,"end":8628}],"$parts":{"symbols":["files/parts/src_frontend_utils_searchFast.ts-0-symbols-1.json","files/parts/src_frontend_utils_searchFast.ts-0-symbols-2.json"]}}
