ne":122,"endLine":122,"text":"// Match found for this subphrase or full phrase","start":3826,"end":3874},{"file":"src/frontend/utils/searchFast.ts","line":127,"endLine":127,"text":"// Word frequency bonus (if multiple query words appear multiple times)","start":3966,"end":4037},{"file":"src/frontend/utils/searchFast.ts","line":128,"endLine":128,"text":"// But score already counts matched unique query words.","start":4050,"end":4105},{"file":"src/frontend/utils/searchFast.ts","line":129,"endLine":129,"text":"// Let's add the extraScore to the original score (which is word match count)","start":4118,"end":4195},{"file":"src/frontend/utils/searchFast.ts","line":139,"endLine":141,"text":"/**\n * Build search index for a Bible\n */","start":4408,"end":4449},{"file":"src/frontend/utils/searchFast.ts","line":147,"endLine":147,"text":"// We expect bibleData to have books","start":4692,"end":4728},{"file":"src/frontend/utils/searchFast.ts","line":173,"endLine":173,"text":"// Index each unique word in the verse","start":5615,"end":5653},{"file":"src/frontend/utils/searchFast.ts","line":196,"endLine":196,"text":"// Skip very short words","start":6340,"end":6364},{"file":"src/frontend/utils/searchFast.ts","line":209,"endLine":209,"text":"// Index n-grams (2 to 5 words) for phrase matching","start":6716,"end":6767},{"file":"src/frontend/utils/searchFast.ts","line":224,"endLine":230,"text":"/**\n * Generate all search terms from query words\n * For \"valley of dry bones\" generates:\n * - Full phrase: \"valley of dry bones\" (weight: 1.0)\n * - Subphrases: \"valley of dry\", \"of dry bones\", \"valley of\", \"dry bones\" (weight: 0.8)\n * - Individual words: \"valley\", \"dry\", \"bones\" (weight: 0.5), skip \"of\" (too short)\n */","start":7186,"end":7507},{"file":"src/frontend/utils/searchFast.ts","line":237,"endLine":237,"text":"// Full phrase (highest weight)","start":7769,"end":7800},{"file":"src/frontend/utils/searchFast.ts","line":242,"endLine":242,"text":"// Contiguous subphrases (sliding window)","start":7905,"end":7946},{"file":"src/frontend/utils/searchFast.ts","line":246,"endLine":246,"text":"// Weight decreases as subphrase gets shorter","start":8161,"end":8206},{"file":"src/frontend/utils/searchFast.ts","line":252,"endLine":252,"text":"// Individual words (filter out very short ones)","start":8352,"end":8400},{"file":"src/frontend/utils/searchFast.ts","line":262,"endLine":262,"text":"// invalidate search index when text cache changes","start":8583,"end":8633}],"$parts":{"symbols":["files/parts/src_frontend_utils_searchFast.ts-0-symbols-1.json","files/parts/src_frontend_utils_searchFast.ts-0-symbols-2.json"]}}
