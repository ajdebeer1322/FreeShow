ine":5,"endLine":5,"text":"// All state is provided to constructor, with no module globals or I/O.","start":167,"end":238},{"file":"src/electron/cloud/syncLedger.ts","line":13,"endLine":13,"text":"// Real last-edit time per full-file store (EVENTS/THEMES/MEDIA).","start":432,"end":497},{"file":"src/electron/cloud/syncLedger.ts","line":14,"endLine":14,"text":"// Used instead of file mtime to avoid false \"newest wins\" entries caused by sync writes.","start":502,"end":591},{"file":"src/electron/cloud/syncLedger.ts","line":21,"endLine":21,"text":"// local ledger (mutated as items are marked created/deleted)","start":772,"end":833},{"file":"src/electron/cloud/syncLedger.ts","line":22,"endLine":22,"text":"// ledger as it came from the cloud (read-only here)","start":868,"end":920},{"file":"src/electron/cloud/syncLedger.ts","line":33,"endLine":33,"text":"// items deleted during THIS run; used so a same-run deletion isn't treated as \"deleted locally\"","start":1120,"end":1216},{"file":"src/electron/cloud/syncLedger.ts","line":47,"endLine":47,"text":"// ----- ledger queries -----","start":1573,"end":1602},{"file":"src/electron/cloud/syncLedger.ts","line":57,"endLine":57,"text":"// was the item already deleted by THIS device (per the cloud ledger), and not re-deleted this run","start":1886,"end":1984},{"file":"src/electron/cloud/syncLedger.ts","line":69,"endLine":69,"text":"// ----- ledger mutations -----","start":2482,"end":2513},{"file":"src/electron/cloud/syncLedger.ts","line":85,"endLine":85,"text":"// with a single device there's nothing to reconcile, so don't track","start":3046,"end":3114},{"file":"src/electron/cloud/syncLedger.ts","line":94,"endLine":94,"text":"// once every device has acknowledged the change, drop the entry","start":3450,"end":3514},{"file":"src/electron/cloud/syncLedger.ts","line":110,"endLine":110,"text":"// ----- merge decisions (item-collections with no per-item \"modified\") -----","start":4034,"end":4111},{"file":"src/electron/cloud/syncLedger.ts","line":112,"endLine":112,"text":"// Resolves cloud entry status (create/skip/delete/download/upload) based on local existence.","start":4117,"end":4210},{"file":"src/electron/cloud/syncLedger.ts","line":113,"endLine":113,"text":"// Newest copy wins for items with \"modified\" fields; collections default to upload.","start":4215,"end":4299},{"file":"src/electron/cloud/syncLedger.ts","line":115,"endLine":115,"text":"// exists only in cloud","start":4431,"end":4454},{"file":"src/electron/cloud/syncLedger.ts","line":120,"endLine":120,"text":"// previously created here but now missing → it was deleted locally","start":4649,"end":4716},{"file":"src/electron/cloud/syncLedger.ts","line":132,"endLine":132,"text":"// absence with no ledger mark → treat as deleted locally","start":5142,"end":5199},{"file":"src/electron/cloud/syncLedger.ts","line":137,"endLine":137,"text":"// exists locally and in cloud, but is marked deleted → propagate the deletion","start":5302,"end":5380},{"file":"src/electron/cloud/syncLedger.ts","line":144,"endLine":144,"text":"// exists on both sides and not deleted → newest wins. Collections have no per-item \"modified\",","start":5625,"end":5720},{"file":"src/electron/cloud/syncLedger.ts","line":145,"endLine":145,"text":"// so callers pass whether the cloud file as a whole is newer than the local one (see mergeCollection).","start":5729,"end":5832},{"file":"src/electron/cloud/syncLedger.ts","line":149,"endLine":149,"text":"// Item present only locally (not in cloud snapshot). Resolves actions based on deletion history.","start":5908,"end":6005},{"file":"src/electron/cloud/syncLedger.ts","line":157,"endLine":157,"text":"// this device had deleted it then restored it → revive","start":6269,"end":6324},{"file":"src/electron/cloud/syncLedger.ts","line":162,"endLine":162,"text":"// someone else deleted it → propagate the deletion locally","start":6499,"end":6558},{"file":"src/electron/cloud/syncLedger.ts","line":167,"endLine":167,"text":"// brand-new local item → mark created so other devices download it","start":6663,"end":6730},{"file":"src/electron/cloud/syncLedger.ts","line":172,"endLine":172,"text":"// Merges one item-collection (e.g. scriptures) per-item. Used to avoid whole-object overwrites.","start":6819,"end":6915},{"file":"src/electron/cloud/syncLedger.ts","line":173,"endLine":173,"text":"// cloudIsNewer resolves conflicts on items that exist on both sides (no per-item \"modified\" to","start":6920,"end":7015},{"file":"src/electron/cloud/syncLedger.ts","line":174,"endLine":174,"text":"// compare, so this is the same whole-file newest-wins check the non-collection settings use).","start":7020,"end":7114},{"file":"src/electron/cloud/syncLedger.ts","line":178,"endLine":178,"text":"// items present in the cloud","start":7342,"end":7371},{"file":"src/electron/cloud/syncLedger.ts","line":186,"endLine":186,"text":"// items present only locally","start":7752,"end":7781}]}
