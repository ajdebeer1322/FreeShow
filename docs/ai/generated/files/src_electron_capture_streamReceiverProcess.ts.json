l the next frame, so pace on the source: waiting","start":8752,"end":8830},{"file":"src/electron/capture/streamReceiverProcess.ts","line":246,"endLine":246,"text":"// after every frame pushes the next fetch past the frame after it","start":8851,"end":8917},{"file":"src/electron/capture/streamReceiverProcess.ts","line":292,"endLine":292,"text":"// if a thumbnail loop is running, upgrade it to full capture","start":10695,"end":10756},{"file":"src/electron/capture/streamReceiverProcess.ts","line":335,"endLine":335,"text":"// ----- OMT -----","start":12125,"end":12143},{"file":"src/electron/capture/streamReceiverProcess.ts","line":342,"endLine":342,"text":"// the codec DLL lives beside the addon; this process has its own environment, so the search","start":12274,"end":12366},{"file":"src/electron/capture/streamReceiverProcess.ts","line":343,"endLine":343,"text":"// path set here is the one its loader actually uses","start":12375,"end":12427},{"file":"src/electron/capture/streamReceiverProcess.ts","line":373,"endLine":373,"text":"// ~60fps ceiling","start":13205,"end":13222},{"file":"src/electron/capture/streamReceiverProcess.ts","line":461,"endLine":461,"text":"/* Video */","start":16490,"end":16501},{"file":"src/electron/capture/streamReceiverProcess.ts","line":527,"endLine":527,"text":"// ----- control channel -----","start":18884,"end":18914}],"$parts":{"symbols":["files/parts/src_electron_capture_streamReceiverProcess.ts-0-symbols-1.json","files/parts/src_electron_capture_streamReceiverProcess.ts-0-symbols-2.json","files/parts/src_electron_capture_streamReceiverProcess.ts-0-symbols-3.json"]}}
