ne":65,"text":"// accidental, then any common chord descriptors (maj, min, m, aug, dim, sus,","start":2386,"end":2463},{"file":"src/frontend/utils/chordTranspose.ts","line":66,"endLine":66,"text":"// add, numbers, parenthesis, extensions) and optional slash bass notes.","start":2468,"end":2540},{"file":"src/frontend/utils/chordTranspose.ts","line":67,"endLine":67,"text":"// Examples matched: C, D7, Bm7, Gmaj7, Asus4, F#(add9), Bbmaj7/G","start":2545,"end":2610},{"file":"src/frontend/utils/chordTranspose.ts","line":68,"endLine":68,"text":"// Allow ASCII and Unicode flats/sharps in the root and in slash bass notes","start":2615,"end":2690},{"file":"src/frontend/utils/chordTranspose.ts","line":69,"endLine":69,"text":"// This regex is more specific to avoid matching section labels like [Chorus], [Verse], etc.","start":2695,"end":2787},{"file":"src/frontend/utils/chordTranspose.ts","line":72,"endLine":72,"text":"// Chord notation uses: note names (A-G), accidentals (b#♭♯), numbers, and specific extensions","start":2958,"end":3052},{"file":"src/frontend/utils/chordTranspose.ts","line":73,"endLine":73,"text":"// If it's longer than 8 chars or contains letters other than standard chord notation, likely not a chord","start":3061,"end":3166},{"file":"src/frontend/utils/chordTranspose.ts","line":75,"endLine":75,"text":"// Return unchanged if it looks like a section label","start":3301,"end":3353}]}
